不降息的风险。","lineHeight":1.7999999523162842,"textAlignVertical":"middle","fontFamily":"Noto Sans SC","fontSize":16,"fontWeight":"normal","letterSpacing":0.32}]},{"type":"frame","id":"wcIvq","name":"head 5","width":"fill_container","stroke":{"align":"inside","thickness":1},"gap":8,"children":[{"type":"text","id":"Io0G0","x":0,"y":0,"name":"##","enabled":false,"fill":"#737373ff","content":"##","lineHeight":1.5,"textAlignVertical":"middle","fontFamily":"Noto Sans SC","fontSize":24,"fontWeight":"700"},{"type":"text","id":"G3TRsr","name":"二、微观经济环境分析","fill":"#0a0a0aff","content":"二、微观经济环境分析","lineHeight":1.5,"textAlignVertical":"middle","fontFamily":"Noto Sans SC","fontSize":24,"fontWeight":"700"}]},{"type":"frame","id":"c31Xzv","name":"body","width":"fill_container","stroke":{"align":"inside","thickness":1},"gap":8,"children":[{"type":"text","id":"v5xPLI","x":0,"y":0,"name":"###","enabled":false,"fill":"#000000ff","content":"###","lineHeight":1.2,"textAlign":"center","textAlignVertical":"middle","fontFamily":"Noto Sans SC","fontSize":30,"fontWeight":"500"},{"type":"text","id":"Y6tBK","name":"盈利层面：标普500指数营收同比增速6.4%，EPS同比增速12.1%，虽较一季度小幅回落0.9个百分点，但盈利超预期公司占比升至80.96%，盈利质量较高，ROE小幅上行至19.2%。","fill":"#0a0a0aff","textGrowth":"fixed-width","width":"fill_container","content":"盈利层面：标普500指数营收同比增速6.4%，EPS同比增速12.1%，虽较一季度小幅回落0.9个百分点，但盈利超预期公司占比升至80.96%，盈利质量较高，ROE小幅上行至19.2%。","lineHeight":1.7999999523162842,"textAlignVertical":"middle","fontFamily":"Noto Sans SC","fontSize":16,"fontWeight":"normal","letterSpacing":0.32}]},{"type":"frame","id":"nZvrc","name":"head 7","width":"fill_container","stroke":{"align":"inside","thickness":1},"gap":8,"children":[{"type":"text","id":"t7ltLT","x":0,"y":0,"name":"###","enabled":false,"fill":"#737373ff","content":"###","lineHeight":1.5,"textAlignVertical":"middle","fontFamily":"Noto Sans SC","fontSize":18,"fontWeight":"700"},{"type":"text","id":"hLU6P","name":"表格展示","fill":"#0a0a0aff","content":"表格展示","lineHeight":1.5,"textAlignVertical":"middle","fontFam