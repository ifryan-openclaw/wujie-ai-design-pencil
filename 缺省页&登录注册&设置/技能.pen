                                                  "enabled": false,
                                                  "fill": "#737373ff",
                                                  "textGrowth": "fixed-width",
                                                  "width": "fill_container(373)",
                                                  "content": "This is an input description.",
                                                  "lineHeight": 1.4285714285714286,
                                                  "fontFamily": "Noto Sans SC",
                                                  "fontSize": 14,
                                                  "fontWeight": "normal"
                                                }
                                              ]
