                                          "id": "rygY1",
                                          "name": "{ \"title\": \"2025年第二季度美股市场研报\", \"author\": \"Mock Research Team\", \"created_at\": \"2025-07-10T10:00:00Z\", \"sections\": [ { \"title\": \"宏观经济回顾\", \"content\": \"2025年第二季度，美国经济保持温和增长，GDP环比约为2.1%。美联储维持政策利率在5.25%–5.50%，市场预期下半年或将降息。\", \"formula\": \"\\\\[ P_0 = \\\\sum_{t=1}^{n} \\\\frac{CF_t}{(1+r)^t} \\\\]\", \"note\": \"随着折现率 r 下降，成长股估值\" }] }",
                                          "fill": "#171717ff",
                                          "textGrowth": "fixed-width",
                                          "width": "fill_container",
                                          "content": "{\n  \"title\": \"2025年第二季度美股市场研报\",\n  \"author\": \"Mock Research Team\",\n  \"created_at\": \"2025-07-10T10:00:00Z\",\n  \"sections\": [\n    {\n      \"title\": \"宏观经济回顾\",\n      \"content\": \"2025年第二季度，美国经济保持温和增长，GDP环比约为2.1%。美联储维持政策利率在5.25%–5.50%，市场预期下半年或将降息。\",\n      \"formula\": \"\\\\[ P_0 = \\\\sum_{t=1}^{n} \\\\frac{CF_t}{(1+r)^t} \\\\]\",\n      \"note\": \"随着折现率 r 下降，成长股估值\"\n     }]\n}",
                                          "lineHeight": 1.5,
                                          "fontFamily": "Geist Mono",
                                          "fontSize": 13,
                                          "fontWeight": "normal"
                                        }
                                      ]
