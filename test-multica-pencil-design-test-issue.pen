                                      "fontWeight": "normal",
                                      "letterSpacing": 0.32
                                    },
                                    {
                                      "type": "text",
                                      "id": "PIhIk",
                                      "name": "\"林风!发什么呆呢?\"一个粗哑的声音打断了他的思绪。",
                                      "fill": "#0a0a0aff",
                                      "textGrowth": "fixed-width",
                                      "width": "fill_container",
                                      "content": "\"林风!发什么呆呢?\"一个粗哑的声音打断了他的思绪。",
                                      "lineHeight": 1.7999999523162842,
                                      "textAlignVertical": "middle",
                                      "fontFamily": "Noto Sans SC",
                                      "fontSize": 16,
