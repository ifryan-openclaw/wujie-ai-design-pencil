                                    },
                                    {
                                      "type": "text",
                                      "id": "l1Ofx",
                                      "name": "青岚宗，外门杂役区。",
                                      "fill": "#0a0a0aff",
                                      "textGrowth": "fixed-width",
                                      "width": "fill_container",
                                      "content": "青岚宗，外门杂役区。",
